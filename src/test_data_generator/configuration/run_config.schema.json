{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test data generator configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["client"],
  "anyOf": [
    {"required": ["provider"]},
    {"required": ["member"]},
    {"required": ["claims"]}
  ],
  "properties": {
    "client": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "output_directory": {"type": "string", "minLength": 1},
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_order": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": {"enum": ["source", "first", "last"]}
          }
        },
        "creation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "directory": {"type": "string", "minLength": 1}
          }
        },
        "updates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "directory": {"type": "string", "minLength": 1},
            "rule_catalog": {"type": "string", "minLength": 1},
            "default_scenario": {"type": "string", "minLength": 1},
            "matching_method": {"type": "string", "minLength": 1},
            "threshold": {"type": "number"},
            "field_selection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "include": {"type": "array", "items": {"type": "string"}},
                "exclude": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "provider": {"$ref": "#/$defs/entity"},
    "member": {"$ref": "#/$defs/entity"},
    "claims": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "professional": {"$ref": "#/$defs/entity"},
        "institutional": {"$ref": "#/$defs/entity"}
      }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "layout": {"type": "string", "minLength": 1},
        "output_order": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": {"enum": ["source", "first", "last"]}
          }
        },
        "updates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scenario": {"type": "string", "minLength": 1},
            "fields": {"type": "array", "items": {"type": "string"}},
            "include": {"type": "array", "items": {"type": "string"}},
            "exclude": {"type": "array", "items": {"type": "string"}},
            "matching_method": {"type": "string", "minLength": 1},
            "threshold": {"type": "number"}
          }
        }
      }
    }
  }
}
