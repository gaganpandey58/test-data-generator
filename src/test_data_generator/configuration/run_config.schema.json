{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test data generator configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["client"],
  "anyOf": [
    {"required": ["provider"]},
    {"required": ["provider_nppes"]},
    {"required": ["member"]},
    {"required": ["claims"]}
  ],
  "properties": {
    "client": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "output_directory": {"type": "string", "minLength": 1},
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_order": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": {"enum": ["source", "first", "last"]}
          }
        },
        "creation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "directory": {"type": "string", "minLength": 1}
          }
        },
        "updates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "directory": {"type": "string", "minLength": 1},
            "rule_catalog": {"type": "string", "minLength": 1},
            "invalid_values_catalog": {"type": "string", "minLength": 1},
            "default_scenario": {"type": "string", "minLength": 1},
            "matching_method": {"type": "string", "minLength": 1},
            "threshold": {"type": "number"},
            "operation": {"$ref": "#/$defs/operation"},
            "field_selection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "include": {"type": "array", "items": {"type": "string"}},
                "exclude": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "provider": {
      "$ref": "#/$defs/provider_entity"
    },
    "provider_nppes": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["count"]},
        {"required": ["individual"]},
        {"required": ["organizational"]}
      ],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "individual": {"type": "integer", "minimum": 0},
        "organizational": {"type": "integer", "minimum": 0}
      }
    },
    "member": {"$ref": "#/$defs/counted_entity"},
    "claims": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "professional": {"$ref": "#/$defs/counted_entity"},
        "institutional": {"$ref": "#/$defs/counted_entity"}
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["UPDATE", "MISSING", "EMPTY", "INVALID", "WEIGHT_CHANGE"]},
        "fields": {"type": "array", "items": {"type": "string"}},
        "condition": {"enum": ["BELOW_LIMIT", "AT_LIMIT", "ABOVE_LIMIT"]}
      }
    },
    "provider_entity": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {"anyOf": [{"required": ["count"]}, {"required": ["nppes"]}, {"required": ["cdf"]}]}
      ]
    },
    "counted_entity": {
      "allOf": [{"$ref": "#/$defs/entity"}, {"required": ["count"]}]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "nppes": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {"required": ["count"]},
            {"required": ["individual"]},
            {"required": ["organizational"]}
          ],
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "individual": {"type": "integer", "minimum": 0},
            "organizational": {"type": "integer", "minimum": 0}
          }
        },
        "cdf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["additional_count"],
          "properties": {"additional_count": {"type": "integer", "minimum": 0}}
        },
        "layout": {"type": "string", "minLength": 1},
        "output_order": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": {"enum": ["source", "first", "last"]}
          }
        },
        "updates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scenario": {"type": "string", "minLength": 1},
            "fields": {"type": "array", "items": {"type": "string"}},
            "include": {"type": "array", "items": {"type": "string"}},
            "exclude": {"type": "array", "items": {"type": "string"}},
            "matching_method": {"type": "string", "minLength": 1},
            "threshold": {"type": "number"},
            "operation": {"$ref": "#/$defs/operation"}
          }
        }
      }
    }
  }
}
