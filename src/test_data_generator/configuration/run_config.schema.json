{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test data generator configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["client"],
  "anyOf": [
    {"required": ["provider"]},
    {"required": ["provider_nppes"]},
    {"required": ["member"]},
    {"required": ["claims"]},
    {"required": ["payments"]},
    {"required": ["entity_configs"]}
  ],
  "properties": {
    "client": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "output_directory": {"type": "string", "minLength": 1},
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_order": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": {"enum": ["source", "first", "last"]}
          }
        },
        "creation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "directory": {"type": "string", "minLength": 1}
          }
        },
        "updates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "directory": {"type": "string", "minLength": 1},
            "rule_catalog": {"type": "string", "minLength": 1},
            "invalid_values_catalog": {"type": "string", "minLength": 1}
          }
        },
        "ingestion_dates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existing": {"type": "string", "pattern": "^[0-9]{8}$"},
            "update": {"enum": ["SAME", "NEWER", "OLDER"]},
            "overrides": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "member": {"$ref": "#/$defs/ingestion_date_override"},
                "provider": {"$ref": "#/$defs/ingestion_date_override"},
                "claims": {"$ref": "#/$defs/ingestion_date_override"},
                "claims_history": {"$ref": "#/$defs/ingestion_date_override"},
                "payments": {"$ref": "#/$defs/ingestion_date_override"}
              }
            }
          }
        }
      }
    },
    "entity_configs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "member", "claims", "payments"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "member": {"type": "string", "minLength": 1},
        "claims": {"type": "string", "minLength": 1},
        "payments": {"type": "string", "minLength": 1}
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["provider", "member", "claims", "payments"]}
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["creation", "updates"]}
    },
    "provider": {
      "$ref": "#/$defs/provider_entity"
    },
    "provider_nppes": {"$ref": "#/$defs/nppes_entity"},
    "member": {"$ref": "#/$defs/member_entity"},
    "claims": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}},
        "modifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}},
        "professional": {"$ref": "#/$defs/claim_entity"},
        "institutional": {"$ref": "#/$defs/claim_entity"},
        "claims_history": {"$ref": "#/$defs/history_domain"}
      }
    },
    "payments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}},
        "modifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}},
        "professional": {"$ref": "#/$defs/counted_entity"},
        "institutional": {"$ref": "#/$defs/counted_entity"}
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["UPDATE", "MISSING", "EMPTY", "INVALID", "WEIGHT_CHANGE", "DUPLICATE"]},
        "fields": {"type": "array", "items": {"type": "string"}},
        "condition": {"enum": ["BELOW_LIMIT", "AT_LIMIT", "ABOVE_LIMIT"]},
        "values": {"type": "object", "additionalProperties": true}
      }
    },
    "modification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["UPDATE", "MISSING", "EMPTY", "INVALID", "WEIGHT_CHANGE", "DUPLICATE"]},
        "fields": {"type": "array", "items": {"type": "string"}},
        "condition": {"enum": ["BELOW_LIMIT", "AT_LIMIT", "ABOVE_LIMIT"]},
        "values": {"type": "object", "additionalProperties": true}
      }
    },
    "match_fixture_code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matching_method"],
      "properties": {
        "matching_method": {"type": "string", "minLength": 1},
        "operation_counts": {"$ref": "#/$defs/operation_counts"},
        "cases": {
          "type": "array",
          "items": {"$ref": "#/$defs/match_fixture_case"}
        },
        "deterministic_cases": {
          "type": "array",
          "items": {"$ref": "#/$defs/match_fixture_case"}
        }
      },
      "anyOf": [
        {"required": ["operation_counts"]},
        {"required": ["cases"]},
        {"required": ["deterministic_cases"]}
      ]
    },
    "operation_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "UPDATE": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "INVALID": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "MISSING": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "EMPTY": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "DUPLICATE": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "WEIGHT_BELOW_LIMIT": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "WEIGHT_AT_LIMIT": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "WEIGHT_ABOVE_LIMIT": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "ELASTICITY_INSIDE": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "ELASTICITY_AT_LIMIT": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "ELASTICITY_OUTSIDE": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "match_fixture_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modifications"],
      "properties": {
        "count": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "expected_outcome": {"enum": ["MATCH", "NO_MATCH"]},
        "modifications": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/modification"}
        }
      }
    },
    "provider_entity": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {"not": {"required": ["mr"]}},
        {"anyOf": [{"required": ["count"]}, {"required": ["nppes"]}, {"required": ["cdf"]}]}
      ]
    },
    "ingestion_date_override": {
      "oneOf": [
        {"enum": ["SAME", "NEWER", "OLDER"]},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existing": {"type": "string", "pattern": "^[0-9]{8}$"},
            "update": {"enum": ["SAME", "NEWER", "OLDER"]}
          },
          "minProperties": 1
        }
      ]
    },
    "counted_entity": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {"required": ["count"]},
        {"not": {"required": ["mr"]}}
      ]
    },
    "claim_entity": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {"required": ["count"]},
        {"not": {"required": ["mr"]}}
      ]
    },
    "nppes_entity": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {"not": {"anyOf": [{"required": ["mr"]}, {"required": ["nppes"]}, {"required": ["cdf"]}, {"required": ["history"]}]}},
        {"anyOf": [{"required": ["count"]}, {"required": ["individual"]}, {"required": ["organizational"]}]}
      ]
    },
    "history_entity": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {"required": ["count"]},
        {"not": {"anyOf": [{"required": ["mr"]}, {"required": ["nppes"]}, {"required": ["cdf"]}, {"required": ["history"]}]}}
      ]
    },
    "history_domain": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}},
        "modifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}},
        "linked": {"type": "boolean"},
        "professional": {"$ref": "#/$defs/history_entity"},
        "institutional": {"$ref": "#/$defs/history_entity"}
      },
      "anyOf": [
        {"required": ["professional"]},
        {"required": ["institutional"]}
      ]
    },
    "member_entity": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {"required": ["count"]}
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "nppes": {"$ref": "#/$defs/nppes_entity"},
        "individual": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "organizational": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "cdf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["additional_count"],
          "properties": {
            "additional_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        },
        "layout": {"type": "string", "minLength": 1},
        "mr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count"],
          "properties": {
            "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "output_order": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "headers": {"enum": ["source", "first", "last"]}
              }
            },
            "updates": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fields": {"type": "array", "items": {"type": "string"}},
                "include": {"type": "array", "items": {"type": "string"}},
                "exclude": {"type": "array", "items": {"type": "string"}},
                "matching_method": {"type": "string", "minLength": 1},
                "threshold": {"type": "number"},
                "operation": {"$ref": "#/$defs/operation"},
                "expected_outcome": {"enum": ["MATCH", "NO_MATCH"]},
                "failure_mode": {"enum": ["MANDATORY_BREAK_EXACT", "MANDATORY_BREAK_BOUNDARY", "INVALID_VALUE", "MISSING_VALUE", "WEIGHT_MISS", "CROSS_METHOD_COLLISION"]},
                "failure_field": {"type": "string", "minLength": 1},
                "collision_method": {"type": "string", "minLength": 1},
                "elasticity_boundary": {"enum": ["INSIDE", "AT", "OUTSIDE"]},
                "modifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}}
              }
            },
            "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}},
            "modifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}},
            "matching_method": {"type": "string", "minLength": 1},
            "expected_outcome": {"enum": ["MATCH", "NO_MATCH"]},
            "match_codes": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"$ref": "#/$defs/match_fixture_code"}
            }
          }
        },
        "history": {"$ref": "#/$defs/history_entity"},
        "linked": {"type": "boolean"},
        "output_order": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": {"enum": ["source", "first", "last"]}
          }
        },
        "updates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fields": {"type": "array", "items": {"type": "string"}},
            "include": {"type": "array", "items": {"type": "string"}},
            "exclude": {"type": "array", "items": {"type": "string"}},
            "matching_method": {"type": "string", "minLength": 1},
            "threshold": {"type": "number"},
            "operation": {"$ref": "#/$defs/operation"},
            "expected_outcome": {"enum": ["MATCH", "NO_MATCH"]},
            "failure_mode": {"enum": ["MANDATORY_BREAK_EXACT", "MANDATORY_BREAK_BOUNDARY", "INVALID_VALUE", "MISSING_VALUE", "WEIGHT_MISS", "CROSS_METHOD_COLLISION"]},
            "failure_field": {"type": "string", "minLength": 1},
            "collision_method": {"type": "string", "minLength": 1},
            "elasticity_boundary": {"enum": ["INSIDE", "AT", "OUTSIDE"]},
            "modifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}}
          }
        },
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}},
        "modifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}},
        "matching_method": {"type": "string", "minLength": 1},
        "threshold": {"type": "number"},
        "expected_outcome": {"enum": ["MATCH", "NO_MATCH"]},
        "failure_mode": {"enum": ["MANDATORY_BREAK_EXACT", "MANDATORY_BREAK_BOUNDARY", "INVALID_VALUE", "MISSING_VALUE", "WEIGHT_MISS", "CROSS_METHOD_COLLISION"]},
        "failure_field": {"type": "string", "minLength": 1},
        "collision_method": {"type": "string", "minLength": 1},
        "elasticity_boundary": {"enum": ["INSIDE", "AT", "OUTSIDE"]},
        "include": {"type": "array", "items": {"type": "string"}},
        "exclude": {"type": "array", "items": {"type": "string"}},
        "match_codes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/match_fixture_code"}
        },
        "source_claims": {"type": "string", "minLength": 1},
        "scenarios": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "frequencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "1": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "7": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "8": {"type": "integer", "minimum": 0, "maximum": 1000000}
          }
        },
        "claim_frequency": {"enum": ["1", "7", "8"]}
      }
    }
  }
}
