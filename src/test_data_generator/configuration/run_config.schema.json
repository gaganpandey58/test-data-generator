{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test data generator configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["client"],
  "anyOf": [
    {"required": ["provider"]},
    {"required": ["provider_nppes"]},
    {"required": ["member"]},
    {"required": ["claims"]},
    {"required": ["payments"]},
    {"required": ["claim_fixtures"]}
  ],
  "properties": {
    "client": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "output_directory": {"type": "string", "minLength": 1},
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_order": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": {"enum": ["source", "first", "last"]}
          }
        },
        "creation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "directory": {"type": "string", "minLength": 1}
          }
        },
        "updates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "directory": {"type": "string", "minLength": 1},
            "rule_catalog": {"type": "string", "minLength": 1},
            "invalid_values_catalog": {"type": "string", "minLength": 1},
            "matching_method": {"type": "string", "minLength": 1},
            "threshold": {"type": "number"},
            "operation": {"$ref": "#/$defs/operation"},
            "field_selection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "include": {"type": "array", "items": {"type": "string"}},
                "exclude": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "provider": {
      "$ref": "#/$defs/provider_entity"
    },
    "provider_nppes": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["count"]},
        {"required": ["individual"]},
        {"required": ["organizational"]}
      ],
      "properties": {
        "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "individual": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "organizational": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "member": {"$ref": "#/$defs/counted_entity"},
    "claims": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "professional": {"$ref": "#/$defs/claim_entity"},
        "institutional": {"$ref": "#/$defs/claim_entity"}
      }
    },
    "payments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "professional": {"$ref": "#/$defs/counted_entity"},
        "institutional": {"$ref": "#/$defs/counted_entity"}
      }
    },
    "claim_fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim_fixture"}
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["UPDATE", "MISSING", "EMPTY", "INVALID", "WEIGHT_CHANGE"]},
        "fields": {"type": "array", "items": {"type": "string"}},
        "condition": {"enum": ["BELOW_LIMIT", "AT_LIMIT", "ABOVE_LIMIT"]}
      }
    },
    "provider_entity": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {"anyOf": [{"required": ["count"]}, {"required": ["nppes"]}, {"required": ["cdf"]}]}
      ]
    },
    "counted_entity": {
      "allOf": [{"$ref": "#/$defs/entity"}, {"required": ["count"]}]
    },
    "claim_entity": {
      "allOf": [{"$ref": "#/$defs/entity"}, {"required": ["count"]}]
    },
    "claim_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_type", "claim_frequency", "recency"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "claim_type": {"enum": ["P", "I"]},
        "claim_frequency": {"enum": ["1", "7", "8"]},
        "existing": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "837": {"type": ["string", "null"], "minLength": 1},
            "ch": {"type": ["string", "null"], "minLength": 1}
          }
        },
        "recency": {
          "oneOf": [
            {"enum": ["NEWER", "SAME", "OLDER"]},
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "837": {"enum": ["NEWER", "SAME", "OLDER"]},
                "ch": {"enum": ["NEWER", "SAME", "OLDER"]}
              }
            }
          ]
        },
        "incoming_timestamp": {"type": "string", "minLength": 1}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "nppes": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {"required": ["count"]},
            {"required": ["individual"]},
            {"required": ["organizational"]}
          ],
          "properties": {
            "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "individual": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "organizational": {"type": "integer", "minimum": 0, "maximum": 1000000}
          }
        },
        "cdf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["additional_count"],
          "properties": {
            "additional_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        },
        "layout": {"type": "string", "minLength": 1},
        "output_order": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": {"enum": ["source", "first", "last"]}
          }
        },
        "updates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fields": {"type": "array", "items": {"type": "string"}},
            "include": {"type": "array", "items": {"type": "string"}},
            "exclude": {"type": "array", "items": {"type": "string"}},
            "matching_method": {"type": "string", "minLength": 1},
            "threshold": {"type": "number"},
            "operation": {"$ref": "#/$defs/operation"}
          }
        },
        "source_claims": {"type": "string", "minLength": 1},
        "scenarios": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "frequencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "1": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "7": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "8": {"type": "integer", "minimum": 0, "maximum": 1000000}
          }
        }
      }
    }
  }
}
