{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test data generator configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["client"],
  "anyOf": [
    {"required": ["provider"]},
    {"required": ["provider_nppes"]},
    {"required": ["member"]},
    {"required": ["claims"]},
    {"required": ["payments"]},
    {"required": ["entity_configs"]}
  ],
  "properties": {
    "client": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "output_directory": {"type": "string", "minLength": 1},
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_order": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": {"enum": ["source", "first", "last"]}
          }
        },
        "creation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "directory": {"type": "string", "minLength": 1}
          }
        },
        "updates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "directory": {"type": "string", "minLength": 1},
            "rule_catalog": {"type": "string", "minLength": 1},
            "invalid_values_catalog": {"type": "string", "minLength": 1},
            "profile": {"type": "string", "minLength": 1},
            "matching_method": {"type": "string", "minLength": 1},
            "threshold": {"type": "number"},
            "operation": {"$ref": "#/$defs/operation"},
            "expected_outcome": {"enum": ["MATCH", "NO_MATCH"]},
            "failure_mode": {"enum": ["MANDATORY_BREAK_EXACT", "MANDATORY_BREAK_BOUNDARY", "INVALID_VALUE", "MISSING_VALUE", "WEIGHT_MISS", "CROSS_METHOD_COLLISION"]},
            "failure_field": {"type": "string", "minLength": 1},
            "collision_method": {"type": "string", "minLength": 1},
            "elasticity_boundary": {"enum": ["INSIDE", "AT", "OUTSIDE"]},
            "modifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}},
            "field_selection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "include": {"type": "array", "items": {"type": "string"}},
                "exclude": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        },
        "ingestion_dates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existing": {"type": "string", "pattern": "^[0-9]{8}$"},
            "update": {"enum": ["SAME", "NEWER", "OLDER"]},
            "overrides": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "member": {"$ref": "#/$defs/ingestion_date_override"},
                "provider": {"$ref": "#/$defs/ingestion_date_override"},
                "claims": {"$ref": "#/$defs/ingestion_date_override"},
                "claims_history": {"$ref": "#/$defs/ingestion_date_override"},
                "payments": {"$ref": "#/$defs/ingestion_date_override"}
              }
            }
          }
        }
      }
    },
    "entity_configs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "member", "claims", "payments"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "member": {"type": "string", "minLength": 1},
        "claims": {"type": "string", "minLength": 1},
        "payments": {"type": "string", "minLength": 1}
      }
    },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "update_profiles", "ingestion"],
      "properties": {
        "operations": {"type": "string", "minLength": 1},
        "update_profiles": {"type": "string", "minLength": 1},
        "ingestion": {"type": "string", "minLength": 1}
      }
    },
    "provider": {
      "$ref": "#/$defs/provider_entity"
    },
    "provider_nppes": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["count"]},
        {"required": ["individual"]},
        {"required": ["organizational"]}
      ],
      "properties": {
        "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "individual": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "organizational": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "member": {"$ref": "#/$defs/member_entity"},
    "claims": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "professional": {"$ref": "#/$defs/claim_entity"},
        "institutional": {"$ref": "#/$defs/claim_entity"}
      }
    },
    "payments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "professional": {"$ref": "#/$defs/counted_entity"},
        "institutional": {"$ref": "#/$defs/counted_entity"}
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["UPDATE", "DIFFERENT", "MISSING", "EMPTY", "INVALID", "WEIGHT_CHANGE", "DUPLICATE"]},
        "fields": {"type": "array", "items": {"type": "string"}},
        "condition": {"enum": ["BELOW_LIMIT", "AT_LIMIT", "ABOVE_LIMIT"]}
      }
    },
    "modification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["UPDATE", "DIFFERENT", "MISSING", "EMPTY", "INVALID", "DUPLICATE"]},
        "fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provider_entity": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {"not": {"required": ["mr"]}},
        {"anyOf": [{"required": ["count"]}, {"required": ["nppes"]}, {"required": ["cdf"]}]}
      ]
    },
    "ingestion_date_override": {
      "oneOf": [
        {"enum": ["SAME", "NEWER", "OLDER"]},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existing": {"type": "string", "pattern": "^[0-9]{8}$"},
            "update": {"enum": ["SAME", "NEWER", "OLDER"]}
          },
          "minProperties": 1
        }
      ]
    },
    "counted_entity": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {"required": ["count"]},
        {"not": {"required": ["mr"]}}
      ]
    },
    "claim_entity": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {"required": ["count"]},
        {"not": {"required": ["mr"]}}
      ]
    },
    "member_entity": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {"required": ["count"]}
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "nppes": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {"required": ["count"]},
            {"required": ["individual"]},
            {"required": ["organizational"]}
          ],
          "properties": {
            "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "individual": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "organizational": {"type": "integer", "minimum": 0, "maximum": 1000000}
          }
        },
        "cdf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["additional_count"],
          "properties": {
            "additional_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        },
        "layout": {"type": "string", "minLength": 1},
        "mr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count"],
          "properties": {
            "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "output_order": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "headers": {"enum": ["source", "first", "last"]}
              }
            },
            "updates": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fields": {"type": "array", "items": {"type": "string"}},
                "include": {"type": "array", "items": {"type": "string"}},
                "exclude": {"type": "array", "items": {"type": "string"}},
                "matching_method": {"type": "string", "minLength": 1},
                "threshold": {"type": "number"},
                "operation": {"$ref": "#/$defs/operation"},
                "expected_outcome": {"enum": ["MATCH", "NO_MATCH"]},
                "failure_mode": {"enum": ["MANDATORY_BREAK_EXACT", "MANDATORY_BREAK_BOUNDARY", "INVALID_VALUE", "MISSING_VALUE", "WEIGHT_MISS", "CROSS_METHOD_COLLISION"]},
                "failure_field": {"type": "string", "minLength": 1},
                "collision_method": {"type": "string", "minLength": 1},
                "elasticity_boundary": {"enum": ["INSIDE", "AT", "OUTSIDE"]},
                "modifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}}
              }
            }
          }
        },
        "output_order": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": {"enum": ["source", "first", "last"]}
          }
        },
        "updates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fields": {"type": "array", "items": {"type": "string"}},
            "include": {"type": "array", "items": {"type": "string"}},
            "exclude": {"type": "array", "items": {"type": "string"}},
            "matching_method": {"type": "string", "minLength": 1},
            "threshold": {"type": "number"},
            "operation": {"$ref": "#/$defs/operation"},
            "expected_outcome": {"enum": ["MATCH", "NO_MATCH"]},
            "failure_mode": {"enum": ["MANDATORY_BREAK_EXACT", "MANDATORY_BREAK_BOUNDARY", "INVALID_VALUE", "MISSING_VALUE", "WEIGHT_MISS", "CROSS_METHOD_COLLISION"]},
            "failure_field": {"type": "string", "minLength": 1},
            "collision_method": {"type": "string", "minLength": 1},
            "elasticity_boundary": {"enum": ["INSIDE", "AT", "OUTSIDE"]},
            "modifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modification"}}
          }
        },
        "source_claims": {"type": "string", "minLength": 1},
        "scenarios": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "frequencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "1": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "7": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "8": {"type": "integer", "minimum": 0, "maximum": 1000000}
          }
        },
        "claim_frequency": {"enum": ["1", "7", "8"]}
      }
    }
  }
}
