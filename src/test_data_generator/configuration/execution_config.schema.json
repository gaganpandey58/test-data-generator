{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test data generator execution configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["config"],
  "properties": {
    "config": {"type": "string", "minLength": 1},
    "entities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["provider", "member", "claims", "payments"]}
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["creation", "updates"]}
    }
  }
}
