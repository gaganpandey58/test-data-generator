{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test data generator configuration",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    {"required": ["provider"]},
    {"required": ["member"]},
    {"required": ["claims"]}
  ],
  "properties": {
    "seed": {"type": "integer"},
    "output_directory": {"type": "string", "minLength": 1},
    "provider": {"$ref": "#/$defs/entity"},
    "member": {"$ref": "#/$defs/entity"},
    "claims": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "professional": {"$ref": "#/$defs/entity"},
        "institutional": {"$ref": "#/$defs/entity"}
      }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "scenarios": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
