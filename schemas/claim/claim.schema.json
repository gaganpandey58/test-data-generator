{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthcare-test-data.local/schemas/claim/claim.schema.json",
  "title": "Synthetic EIP/GDF medical claim with embedded 835 payment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "CH_CLIENT_DATA_PLATFORM", "CH_CLIENT_CLAIM_UNIQUE_ID", "CH_CLIENT_CLAIM_ID",
    "CH_CLIENT_ROOT_CLAIM_ID", "CH_CLIENT_CLAIM_VERSION_NUMBER", "CH_CLIENT_ORIGINAL_CLAIM_ID",
    "CH_NUMBER_OF_ADJUSTMENTS", "CH_CLAIM_TYPE", "CH_CLAIM_FREQUENCY_CODE",
    "CH_PATIENT_CLIENT_ID", "CH_SUBSCRIBER_CLIENT_ID", "CH_BILLING_PROVIDER_CLIENT_ID",
    "CH_BILLING_PROVIDER_NPI", "CH_BILLING_PROVIDER_FEDERAL_TAX_ID",
    "CH_CLAIM_SERVICE_FROM_DATE", "CH_CLAIM_SERVICE_TO_DATE", "CH_DIAGNOSIS_CODE_01",
    "CH_CHARGE_AMOUNT", "CH_ALLOWED_AMOUNT", "CH_PAID_AMOUNT", "CH_CLAIM_PAID_DATE",
    "CH_CHECK_DATE", "CH_CHECK_NUMBER", "CH_PAYMENT_STATUS", "CH_RECORD_TAG",
    "CH_RECORD_STATUS", "CH_SOURCE_UPDATED_AT", "CH_PAYMENT_CLAIM_ID", "CLAIM_DETAIL"
  ],
  "allOf": [
    {
      "if": {"properties": {"CH_CLAIM_TYPE": {"const": "P"}}},
      "then": {"required": ["CH_PLACE_OF_SERVICE_CODE", "CH_RENDERING_PROVIDER_NPI"]}
    },
    {
      "if": {"properties": {"CH_CLAIM_TYPE": {"const": "I"}}},
      "then": {"required": ["CH_TYPE_OF_BILL_CODE", "CH_ATTENDING_PROVIDER_NPI"]}
    }
  ],
  "properties": {
    "CH_CLIENT_DATA_PLATFORM": {"type": "string", "maxLength": 20},
    "CH_CLIENT_CLAIM_UNIQUE_ID": {"type": "string", "minLength": 1, "maxLength": 75},
    "CH_CLIENT_CLAIM_ID": {"type": "string", "minLength": 1, "maxLength": 25},
    "CH_CLIENT_ROOT_CLAIM_ID": {"type": "string", "minLength": 1, "maxLength": 25},
    "CH_CLIENT_CLAIM_VERSION_NUMBER": {"type": "string", "maxLength": 25},
    "CH_CLIENT_ORIGINAL_CLAIM_ID": {"type": "string", "maxLength": 25},
    "CH_NUMBER_OF_ADJUSTMENTS": {"type": "integer", "minimum": 0},
    "CH_BILLING_PROVIDER_CLAIM_ID": {"type": "string"},
    "CH_CLAIM_TYPE": {"enum": ["P", "I"]},
    "CH_CLAIM_FREQUENCY_CODE": {"enum": ["1", "7", "8"]},
    "CH_PATIENT_CLIENT_ID": {"type": "string", "minLength": 1, "maxLength": 35},
    "CH_PATIENT_CLIENT_MASTER_ID": {"type": "string"},
    "CH_PATIENT_FIRST_NAME": {"type": "string", "maxLength": 35},
    "CH_PATIENT_LAST_NAME": {"type": "string", "maxLength": 60},
    "CH_PATIENT_BIRTH_DATE": {"$ref": "#/$defs/date"},
    "CH_PATIENT_GENDER": {"type": "string", "maxLength": 1},
    "CH_PATIENT_ZIP": {"type": "string"},
    "CH_SUBSCRIBER_CLIENT_ID": {"type": "string", "minLength": 1, "maxLength": 25},
    "CH_SUBSCRIBER_CLIENT_MASTER_ID": {"type": "string"},
    "CH_SUBSCRIBER_SSN": {"type": "string", "pattern": "^[0-9]{9}$"},
    "CH_BILLING_PROVIDER_CLIENT_ID": {"type": "string", "minLength": 1},
    "CH_BILLING_PROVIDER_CLIENT_MASTER_ID": {"type": "string"},
    "CH_BILLING_PROVIDER_NPI": {"type": "string", "pattern": "^[0-9]{10}$"},
    "CH_BILLING_PROVIDER_FEDERAL_TAX_ID": {"type": "string", "pattern": "^[0-9]{9}$"},
    "CH_RENDERING_PROVIDER_CLIENT_ID": {"type": "string"},
    "CH_RENDERING_PROVIDER_NPI": {"type": "string", "pattern": "^[0-9]{10}$"},
    "CH_REFERRING_PROVIDER_NPI": {"type": "string", "pattern": "^[0-9]{10}$"},
    "CH_SERVICE_FACILITY_NPI": {"type": "string", "pattern": "^[0-9]{10}$"},
    "CH_ATTENDING_PROVIDER_NPI": {"type": "string", "pattern": "^[0-9]{10}$"},
    "CH_OPERATING_PROVIDER_NPI": {"type": "string", "pattern": "^[0-9]{10}$"},
    "CH_PATIENT_ACCOUNT_CONTROL_NUMBER": {"type": "string"},
    "CH_CLAIM_SERVICE_FROM_DATE": {"$ref": "#/$defs/date"},
    "CH_CLAIM_SERVICE_TO_DATE": {"$ref": "#/$defs/date"},
    "CH_ADMISSION_DATE": {"$ref": "#/$defs/date"},
    "CH_DISCHARGE_DATE": {"$ref": "#/$defs/date"},
    "CH_ADMISSION_TYPE": {"type": "string"},
    "CH_ADMISSION_SOURCE_CODE": {"type": "string"},
    "CH_PATIENT_DISCHARGE_STATUS_CODE": {"type": "string"},
    "CH_ICD_VERSION_CODE": {"type": "string"},
    "CH_ADMITTING_DIAGNOSIS_CODE": {"type": "string"},
    "CH_DIAGNOSIS_CODE_01": {"type": "string"},
    "CH_TYPE_OF_BILL_CODE": {"type": "string"},
    "CH_PLACE_OF_SERVICE_CODE": {"type": "string"},
    "CH_CHARGE_AMOUNT": {"$ref": "#/$defs/amount"},
    "CH_ALLOWED_AMOUNT": {"$ref": "#/$defs/amount"},
    "CH_COINSURANCE_AMOUNT": {"$ref": "#/$defs/amount"},
    "CH_COPAY_AMOUNT": {"$ref": "#/$defs/amount"},
    "CH_DEDUCTIBLE_AMOUNT": {"$ref": "#/$defs/amount"},
    "CH_PATIENT_LIABILITY_AMOUNT": {"$ref": "#/$defs/amount"},
    "CH_PAID_AMOUNT": {"$ref": "#/$defs/amount"},
    "CH_ADJUDICATED_DATE": {"$ref": "#/$defs/date"},
    "CH_CLAIM_PAID_DATE": {"$ref": "#/$defs/date"},
    "CH_CHECK_DATE": {"$ref": "#/$defs/date"},
    "CH_CHECK_NUMBER": {"type": "string", "minLength": 1, "maxLength": 50},
    "CH_PAYMENT_CHECK_NUMBER": {"type": "string"},
    "CH_PAYMENT_STATUS": {"type": "string", "minLength": 1},
    "CH_PAYMENT_STATUS_CODE": {"enum": ["1", "22"]},
    "CH_PAYMENT_METHOD": {"type": "string"},
    "CH_RECORD_TAG": {"enum": ["837 Provisional", "CH Verified", "835 Provisional"]},
    "CH_RECORD_STATUS": {"enum": ["New", "Active", "Void", "Orphan Payment"]},
    "CH_SOURCE_UPDATED_AT": {"$ref": "#/$defs/date"},
    "CH_PAYMENT_CLAIM_ID": {"type": "string", "minLength": 1},
    "CLAIM_DETAIL": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/line"}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{8}$"},
    "amount": {"type": "number", "minimum": 0},
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CD_CLAIM_LINE_KEY", "CD_CLAIM_LINE_NUMBER", "CD_ORIGINAL_CLAIM_LINE_NUMBER",
        "CD_SERVICE_FROM_DATE", "CD_SERVICE_TO_DATE", "CD_SUBMITTED_PROCEDURE_CODE",
        "CD_SUBMITTED_UNITS", "CD_CHARGE_AMOUNT",
        "CD_ALLOWED_AMOUNT", "CD_PAID_AMOUNT", "CD_LINE_PAID_DATE", "CD_LINE_ADJUSTMENTS"
      ],
      "properties": {
        "CD_CLAIM_LINE_KEY": {"type": "string", "minLength": 1},
        "CD_CLAIM_LINE_NUMBER": {"type": "integer", "minimum": 1},
        "CD_ORIGINAL_CLAIM_LINE_NUMBER": {"type": "integer", "minimum": 1},
        "CD_SERVICE_FROM_DATE": {"$ref": "#/$defs/date"},
        "CD_SERVICE_TO_DATE": {"$ref": "#/$defs/date"},
        "CD_PLACE_OF_SERVICE_CODE": {"type": "string"},
        "CD_DIAGNOSIS_POINTER_01": {"type": "string"},
        "CD_SUBMITTED_PROCEDURE_CODE_QUALIFIER": {"type": "string"},
        "CD_SUBMITTED_PROCEDURE_CODE": {"type": "string", "minLength": 1},
        "CD_SUBMITTED_REVENUE_CODE": {"type": "string", "minLength": 1},
        "CD_ALLOWED_REVENUE_CODE": {"type": "string"},
        "CD_SUBMITTED_PROCEDURE_MODIFIER_01": {"type": "string"},
        "CD_SUBMITTED_PROCEDURE_MODIFIER_02": {"type": "string"},
        "CD_SUBMITTED_UNITS": {"type": "string", "pattern": "^[0-9]+$"},
        "CD_SUBMITTED_UNITS_TYPE": {"type": "string"},
        "CD_CHARGE_AMOUNT": {"$ref": "#/$defs/amount"},
        "CD_ALLOWED_AMOUNT": {"$ref": "#/$defs/amount"},
        "CD_COINSURANCE_AMOUNT": {"$ref": "#/$defs/amount"},
        "CD_COPAY_AMOUNT": {"$ref": "#/$defs/amount"},
        "CD_DEDUCTIBLE_AMOUNT": {"$ref": "#/$defs/amount"},
        "CD_PATIENT_LIABILITY_AMOUNT": {"$ref": "#/$defs/amount"},
        "CD_PAID_AMOUNT": {"$ref": "#/$defs/amount"},
        "CD_LINE_PAID_DATE": {"$ref": "#/$defs/date"},
        "CD_RENDERING_PROVIDER_CLIENT_ID": {"type": "string"},
        "CD_RENDERING_PROVIDER_NPI": {"type": "string", "pattern": "^[0-9]{10}$"},
        "CD_LINE_ADJUSTMENTS": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["reason_code", "amount"],
            "properties": {"reason_code": {"type": "string"}, "amount": {"$ref": "#/$defs/amount"}}
          }
        }
      }
    }
  }
}
