{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://test-data-generator.local/schemas/claim/claim.schema.json",
  "title": "Synthetic Cotiviti/EIP 837 claim",
  "description": "One schema for the two internally separated professional and institutional claim streams.",
  "oneOf": [
    {"$ref": "#/$defs/professional"},
    {"$ref": "#/$defs/institutional"}
  ],
  "$defs": {
    "professional": {
      "type": "object",
      "required": [
        "FILE_TYPE", "CH_CLAIM_TYPE", "CH_CLIENT_CLAIM_ID", "CH_CLIENT_ROOT_CLAIM_ID",
        "CH_CLIENT_CLAIM_UNIQUE_ID", "CH_PATIENT_CLIENT_ID", "CH_BILLING_PROVIDER_NPI",
        "CH_RENDERING_PROVIDER_NPI", "CH_PLACE_OF_SERVICE_CODE", "CH_CLAIM_SERVICE_FROM_DATE",
        "CH_CLAIM_SERVICE_TO_DATE", "CH_DIAGNOSIS_CODE_01", "CLAIM_DETAIL", "otherAttributes",
        "cotiviti.batch_id", "cotiviti.message_id", "cotiviti.source_format"
      ],
      "properties": {
        "FILE_TYPE": {"const": "837P"},
        "CH_CLAIM_TYPE": {"const": "P"},
        "CH_CLIENT_CLAIM_ID": {"type": "string", "pattern": "^PCLM[0-9]{9}(?:-R2)?$"},
        "CH_CLIENT_ROOT_CLAIM_ID": {"type": "string", "pattern": "^PROOT[0-9]{8}$"},
        "CH_CLIENT_CLAIM_UNIQUE_ID": {"type": "string", "minLength": 1},
        "CH_PATIENT_CLIENT_ID": {"type": "string", "minLength": 1},
        "CH_BILLING_PROVIDER_NPI": {"type": "integer", "minimum": 1000000000, "maximum": 9999999999},
        "CH_RENDERING_PROVIDER_NPI": {"type": "integer", "minimum": 1000000000, "maximum": 9999999999},
        "CH_PLACE_OF_SERVICE_CODE": {"type": "string", "pattern": "^[0-9]{2}$"},
        "CH_CLAIM_SERVICE_FROM_DATE": {"type": "string", "pattern": "^[0-9]{8}$"},
        "CH_CLAIM_SERVICE_TO_DATE": {"type": "string", "pattern": "^[0-9]{8}$"},
        "CH_DIAGNOSIS_CODE_01": {"type": "string", "minLength": 1},
        "ROWID": false,
        "otherAttributes": {"type": "object"},
        "CLAIM_DETAIL": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/professionalLine"}},
        "cotiviti.batch_id": {"type": "string", "minLength": 1},
        "cotiviti.message_id": {"type": "string", "minLength": 1},
        "cotiviti.source_format": {"const": "edi_x12_837P"}
      },
      "additionalProperties": true
    },
    "institutional": {
      "type": "object",
      "required": [
        "ROWID", "FILE_TYPE", "CH_CLAIM_TYPE", "CH_CLIENT_CLAIM_ID", "CH_CLIENT_ROOT_CLAIM_ID",
        "CH_CLIENT_CLAIM_UNIQUE_ID", "CH_PATIENT_CLIENT_ID", "CH_BILLING_PROVIDER_NPI",
        "CH_ATTENDING_PROVIDER_NPI", "CH_TYPE_OF_BILL_CODE", "CH_CLAIM_SERVICE_FROM_DATE",
        "CH_CLAIM_SERVICE_TO_DATE", "CH_DIAGNOSIS_CODE_01", "CLAIM_DETAIL", "otherAttributes",
        "cotiviti.batch_id", "cotiviti.message_id", "cotiviti.source_format"
      ],
      "properties": {
        "ROWID": {"type": "string", "format": "uuid"},
        "FILE_TYPE": {"const": "837I"},
        "CH_CLAIM_TYPE": {"const": "O"},
        "CH_CLIENT_CLAIM_ID": {"type": "string", "pattern": "^ICLM[0-9]{9}(?:-R2)?$"},
        "CH_CLIENT_ROOT_CLAIM_ID": {"type": "string", "pattern": "^IROOT[0-9]{8}$"},
        "CH_CLIENT_CLAIM_UNIQUE_ID": {"type": "string", "minLength": 1},
        "CH_PATIENT_CLIENT_ID": {"type": "string", "minLength": 1},
        "CH_BILLING_PROVIDER_NPI": {"type": "integer", "minimum": 1000000000, "maximum": 9999999999},
        "CH_ATTENDING_PROVIDER_NPI": {"type": "integer", "minimum": 1000000000, "maximum": 9999999999},
        "CH_TYPE_OF_BILL_CODE": {"type": "string", "minLength": 1},
        "CH_CLAIM_SERVICE_FROM_DATE": {"type": "string", "pattern": "^[0-9]{8}$"},
        "CH_CLAIM_SERVICE_TO_DATE": {"type": "string", "pattern": "^[0-9]{8}$"},
        "CH_DIAGNOSIS_CODE_01": {"type": "string", "minLength": 1},
        "otherAttributes": {"type": "null"},
        "CLAIM_DETAIL": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/institutionalLine"}},
        "cotiviti.batch_id": {"type": "string", "minLength": 1},
        "cotiviti.message_id": {"type": "string", "minLength": 1},
        "cotiviti.source_format": {"const": "edi_x12_837I"}
      },
      "additionalProperties": true
    },
    "professionalLine": {
      "type": "object",
      "required": ["CD_CLAIM_LINE_NUMBER", "CD_SERVICE_FROM_DATE", "CD_SERVICE_TO_DATE", "CD_PLACE_OF_SERVICE_CODE", "CD_SUBMITTED_PROCEDURE_CODE", "CD_CHARGE_AMOUNT"],
      "properties": {
        "CD_CLAIM_LINE_NUMBER": {"type": "integer", "minimum": 1},
        "CD_SERVICE_FROM_DATE": {"type": "string", "pattern": "^[0-9]{8}$"},
        "CD_SERVICE_TO_DATE": {"type": "string", "pattern": "^[0-9]{8}$"},
        "CD_PLACE_OF_SERVICE_CODE": {"type": "string", "pattern": "^[0-9]{2}$"},
        "CD_SUBMITTED_PROCEDURE_CODE": {"type": "string", "minLength": 1},
        "CD_CHARGE_AMOUNT": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "institutionalLine": {
      "type": "object",
      "required": ["CD_CLAIM_LINE_NUMBER", "CD_SERVICE_FROM_DATE", "CD_SERVICE_TO_DATE", "CD_SUBMITTED_REVENUE_CODE", "CD_CHARGE_AMOUNT"],
      "properties": {
        "CD_CLAIM_LINE_NUMBER": {"type": "integer", "minimum": 1},
        "CD_SERVICE_FROM_DATE": {"type": "string", "pattern": "^[0-9]{8}$"},
        "CD_SERVICE_TO_DATE": {"type": "string", "pattern": "^[0-9]{8}$"},
        "CD_SUBMITTED_REVENUE_CODE": {"type": "string", "minLength": 1},
        "CD_CHARGE_AMOUNT": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    }
  }
}
